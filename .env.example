# Copy this file to .env and fill it in.  NEVER commit .env — it holds your keys.

# ===== LLM (https://openrouter.ai/keys) =====
OPENROUTER_API_KEY=

# ===== YouTube =====
# OAuth client file from Google Cloud (Desktop app). Then run once: uv run splitter --login
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# private / unlisted / public  (Google forces "private" until your API project passes the YouTube audit)
YOUTUBE_PRIVACY=public
# Max uploads per day (the default API quota allows ~6). Extra clips wait and upload after the reset.
YOUTUBE_DAILY_LIMIT=6

# ===== Instagram (Business or Creator account) =====
# Long-lived token (expires every 60 days) and your Instagram user ID
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# graph.instagram.com for tokens starting with IG..., graph.facebook.com for tokens starting with EAA...
INSTAGRAM_API_HOST=graph.instagram.com

# ===== Tuning (optional) =====
# Caption languages to fetch, comma separated (e.g. en,hi)
TRANSCRIPT_LANGUAGES=en
# Clips per video
MAX_CLIPS=3
# Seconds added before/after each moment
CLIP_PADDING=1.5
# Only the newest N videos keep their clip files on disk; older ones are deleted
KEEP_VIDEOS=3
# Biggest video you can drop on the web page
MAX_UPLOAD_MB=1024

# ===== Web page (server mode) =====
APP_USER=admin
# REQUIRED for the web page. Pick a long random password — this page can post to your accounts
APP_PASSWORD=
APP_PORT=8080
# Retry clips waiting for YouTube's daily cap every N hours
PENDING_EVERY_HOURS=3

# ===== YouTube blocking servers (only if you see "confirm you are not a bot") =====
# Cookies exported from a logged-in browser (Netscape format), and/or a residential proxy
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
